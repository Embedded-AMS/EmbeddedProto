                {% for oneof_field in first_oneof.get_fields() %}
                case FieldNumber::{{oneof_field.get_variable_id_name()}}:
                  field_id = static_cast<uint32_t>(FieldNumber::{{ oneof_field.get_variable_id_name() }});
                  state.field_id = field_id;
                  state.phase = ::EmbeddedProto::Phase::TAG;
                  break;
                {% endfor %}
                default:
                  // No field in this oneof group is set, skip to next oneof or complete
                  {% if typedef.oneofs|length > 1 %}
                  // Move to next oneof group - check which field is set
                  {% set next_oneof = typedef.oneofs[1] %}
                  switch(get_{{next_oneof.get_which_oneof()}}())
                  {
                    {% for next_field in next_oneof.get_fields() %}
                    case FieldNumber::{{next_field.get_variable_id_name()}}:
                      field_id = static_cast<uint32_t>(FieldNumber::{{ next_field.get_variable_id_name() }});
                      state.field_id = field_id;
                      state.phase = ::EmbeddedProto::Phase::TAG;
                      break;
                    {% endfor %}
                    default:
                      {% if typedef.oneofs|length > 2 %}
                      // No field in next oneof is set either, move to next
                      {% set next_next_oneof = typedef.oneofs[2] %}
                      switch(get_{{next_next_oneof.get_which_oneof()}}())
                      {
                        {% for next_next_field in next_next_oneof.get_fields() %}
