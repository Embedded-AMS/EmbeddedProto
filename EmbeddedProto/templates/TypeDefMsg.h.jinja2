    ::EmbeddedProto::Error serialize_partial(::EmbeddedProto::WriteBufferInterface& buffer, 
                                            ::EmbeddedProto::MessageState& state) const override
    {
      {% if typedef.fields|length == 0 and typedef.oneofs|length == 0 %}
      (void)buffer; // Empty message thus unused.
      (void)state;  // Empty message thus unused.
      {% endif %}
      ::EmbeddedProto::Error return_value = ::EmbeddedProto::Error::NO_ERRORS;
      
      // Get the field id to serialize (from state or start from first field)
      uint32_t field_id = state.field_id;
      
      // Iterate through fields based on state
      while((::EmbeddedProto::Error::NO_ERRORS == return_value) && 
            (::EmbeddedProto::Phase::COMPLETE != state.phase))
      {
        // Determine which field to serialize based on field_id
        switch(field_id)
        {
          case 0:
            // Start of serialization - initialize state
            {% if typedef.fields|length > 0 %}
            // Start with first regular field
            state.field_id = static_cast<uint32_t>(FieldNumber::{{ typedef.fields[0].get_variable_id_name() }});
            state.phase = ::EmbeddedProto::Phase::TAG;
            {% elif typedef.oneofs|length > 0 %}
            // For oneof-only messages, find the first oneof field that is set
            {% for oneof in typedef.oneofs %}
            {% for field in oneof.get_fields() %}
            if(FieldNumber::{{field.get_variable_id_name()}} == {{field.get_which_oneof()}})
            {
                state.field_id = static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}});
                state.phase = ::EmbeddedProto::Phase::TAG;
                field_id = state.field_id;
                break;
            }
            {% endfor %}
            {% endfor %}
            // If no oneof field is set, we're done
            if(0 == state.field_id)
            {
                state.phase = ::EmbeddedProto::Phase::COMPLETE;
            }
            {% else %}
            state.field_id = 0;
            state.phase = ::EmbeddedProto::Phase::COMPLETE;
            {% endif %}
            field_id = state.field_id;
            break;
            
          {% for field in typedef.fields %}
          case static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}):
            {{ field.render_serialize_partial(environment)|indent(12) }}
            break;
            
          {% endfor %}
          {% for oneof in typedef.oneofs %}
          {% for field in oneof.get_fields() %}
          case static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}):
            // Check if this oneof field is the one that's set
            if(FieldNumber::{{field.get_variable_id_name()}} == {{field.get_which_oneof()}})
            {
              {{ field.render_serialize_partial(environment)|indent(14) }}
            }
            else
            {
              // This oneof field is not set, skip to complete
              state.phase = ::EmbeddedProto::Phase::COMPLETE;
            }
            break;
            
          {% endfor %}
          {% endfor %}
          default:
            // All fields serialized
            state.phase = ::EmbeddedProto::Phase::COMPLETE;
            break;
        }
        
        // Move to next field when current field is complete
        if((::EmbeddedProto::Phase::COMPLETE == state.phase) && 
           (::EmbeddedProto::Error::NO_ERRORS == return_value))
        {
          // Reset child state for nested messages before moving to next field
