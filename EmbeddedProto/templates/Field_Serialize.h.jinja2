{# Unified serialize template for all field types.
   - Basic types and enums use serialize_with_id() (FieldTemplate)
   - Messages, strings, bytes use serialize_len()
   - Packed repeated fields use serialize_len()
   - Unpacked repeated fields iterate and call serialize_len() on each element
#}
{% if field.uses_serialize_len() %}
{# Field types that use serialize_len(): messages, strings, bytes, repeated #}
{% if field.callback_is_len_expanded() %}
{# Map callback storage: pull each entry from the bound source and emit it length delimited, the same framing a resident map uses. #}
if(::EmbeddedProto::Error::NO_ERRORS == return_value)
{
  return_value = {{field.get_variable_name()}}.serialize_expanded_len(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer);
}
{% elif field.callback_is_expanded() %}
{# Repeated callback storage: pull elements from the bound source and emit each EXPANDED (one tag+value per element) in a single call. #}
if(::EmbeddedProto::Error::NO_ERRORS == return_value)
{
  return_value = {{field.get_variable_name()}}.serialize_expanded(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer);
}
{% elif field.is_packed is defined and not field.is_packed() and field.element_is_length_delimited() %}
{# Unpacked repeated message/string/bytes field - iterate over elements. Use true for optional so empty elements are still serialized. #}
if(::EmbeddedProto::Error::NO_ERRORS == return_value)
{
  for(uint32_t i = 0; (i < {{field.get_variable_name()}}.get_length()) && (::EmbeddedProto::Error::NO_ERRORS == return_value); ++i)
  {
    return_value = {{field.get_variable_name()}}.get_const(i).serialize_len(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), {{field.get_variable_name()}}.get_const(i).serialized_size(), buffer, true);
  }
}
{% elif field.is_packed is defined and not field.is_packed() %}
{# Expanded (EXPANDED feature) repeated scalar/enum field - one tag+value per element. #}
if(::EmbeddedProto::Error::NO_ERRORS == return_value)
{
  for(uint32_t i = 0; (i < {{field.get_variable_name()}}.get_length()) && (::EmbeddedProto::Error::NO_ERRORS == return_value); ++i)
  {
    return_value = {{field.get_variable_name()}}.get_const(i).serialize_with_id(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, true);
  }
}
{% elif (field.optional or (field.oneof is not none)) %}
if(has_{{field.get_name()}}() && (::EmbeddedProto::Error::NO_ERRORS == return_value))
{
{% if field.is_delimited() %}
{# DELIMITED message_encoding: single-pass group framing, no size pre-pass. #}
  return_value = {{field.get_variable_name()}}.serialize_as_group(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer);
{% else %}
  return_value = {{field.get_variable_name()}}.serialize_len(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), {{field.get_size_expression()}}, buffer, true);
{% endif %}
}
{% elif field.always_serialize %}
{# LEGACY_REQUIRED field: always serialize, even at the default value. #}
if(::EmbeddedProto::Error::NO_ERRORS == return_value)
{
{% if field.is_delimited() %}
  return_value = {{field.get_variable_name()}}.serialize_as_group(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer);
{% else %}
  return_value = {{field.get_variable_name()}}.serialize_len(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), {{field.get_size_expression()}}, buffer, true);
{% endif %}
}
{% elif field.is_delimited() %}
{# DELIMITED message_encoding on an implicit-presence message field. #}
if(::EmbeddedProto::Error::NO_ERRORS == return_value)
{
  return_value = {{field.get_variable_name()}}.serialize_as_group(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer);
}
{% else %}
if(::EmbeddedProto::Error::NO_ERRORS == return_value)
{
  return_value = {{field.get_variable_name()}}.serialize_len(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), {{field.get_size_expression()}}, buffer, false);
}
{% endif %}
{% else %}
{# Basic types and enums use serialize_with_id() #}
{% if (field.optional or (field.oneof is not none)) %}
if(has_{{field.get_name()}}() && (::EmbeddedProto::Error::NO_ERRORS == return_value))
{
  return_value = {{field.get_variable_name()}}.serialize_with_id(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, true);
}
{% elif field.always_serialize %}
{# LEGACY_REQUIRED field: always serialize, even at the default value. #}
if(::EmbeddedProto::Error::NO_ERRORS == return_value)
{
  return_value = {{field.get_variable_name()}}.serialize_with_id(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, true);
}
{% else %}
if(::EmbeddedProto::Error::NO_ERRORS == return_value)
{
  return_value = {{field.get_variable_name()}}.serialize_with_id(static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, false);
}
{% endif %}
{% endif %}
