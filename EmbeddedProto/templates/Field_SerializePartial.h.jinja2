{# Template for partial field serialization.
   This simplified template delegates to library methods instead of inlining
   the state machine logic. See doc/design/partial_serialization_design_v2.md
#}

{% if field.uses_serialize_len() %}
{# ======================================================================= #}
{# Field types that use LENGTH_DELIMITED: messages, strings, bytes, repeated #}
{# ======================================================================= #}

{% if (field.optional or (field.oneof is not none)) %}
{# ------------------------------------------------------------------------- #}
{# Optional or oneof LENGTH_DELIMITED field #}
{# ------------------------------------------------------------------------- #}
if(has_{{field.get_name()}}())
{
{% if field.is_delimited() %}
  return_value = {{field.get_variable_name()}}.serialize_partial_as_group(
      static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, state);
{% else %}
  return_value = {{field.get_variable_name()}}.serialize_partial_as_field(
      static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, state, true);
{% endif %}
}
else
{
  state.phase = ::EmbeddedProto::FieldProcessingPhase::COMPLETE;
}

{% elif field.is_delimited() %}
{# ------------------------------------------------------------------------- #}
{# Implicit / LEGACY_REQUIRED DELIMITED message field. #}
{# ------------------------------------------------------------------------- #}
return_value = {{field.get_variable_name()}}.serialize_partial_as_group(
    static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, state);
{% else %}
{# ------------------------------------------------------------------------- #}
{# Implicit / LEGACY_REQUIRED LENGTH_DELIMITED field. LEGACY_REQUIRED is always #}
{# serialized (force=true), implicit only when != default (force=false).      #}
{# ------------------------------------------------------------------------- #}
return_value = {{field.get_variable_name()}}.serialize_partial_as_field(
    static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, state, {{ "true" if field.always_serialize else "false" }});
{% endif %}

{% else %}
{# ======================================================================= #}
{# Basic scalar types and enums #}
{# ======================================================================= #}

{% if (field.optional or (field.oneof is not none)) %}
{# ------------------------------------------------------------------------- #}
{# Optional or oneof scalar field #}
{# ------------------------------------------------------------------------- #}
if(has_{{field.get_name()}}())
{
  return_value = {{field.get_variable_name()}}.serialize_partial_with_id(
      static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, state, true);
}
else
{
  state.phase = ::EmbeddedProto::FieldProcessingPhase::COMPLETE;
}

{% else %}
{# ------------------------------------------------------------------------- #}
{# Implicit / LEGACY_REQUIRED scalar field. LEGACY_REQUIRED is always          #}
{# serialized (force=true), implicit only when != default (force=false).       #}
{# ------------------------------------------------------------------------- #}
return_value = {{field.get_variable_name()}}.serialize_partial_with_id(
    static_cast<uint32_t>(FieldNumber::{{field.get_variable_id_name()}}), buffer, state, {{ "true" if field.always_serialize else "false" }});
{% endif %}
{% endif %}